<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KSCaseProductGallery"
             x:Class="KSCaseProductGallery.MainPage">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 상단 바 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10">
            <!-- 로그아웃 버튼 -->
            <Button x:Name="LogoutButton"
                    Text="로그아웃"
                    IsVisible="{Binding Source={x:Static local:AdminState.Instance}, Path=IsAdmin}"
                    Clicked="OnLogoutClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="Start" />

            <!-- 중앙 타이틀 -->
            <Label Text="제품 갤러리"
                   Grid.Column="1"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="20"
                   x:Name="AdminTapArea">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdminAreaTapped" NumberOfTapsRequired="1"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- 제품 추가 버튼 -->
            <Button x:Name="AddProductButton"
                    Text="제품 추가"
                    IsVisible="{Binding Source={x:Static local:AdminState.Instance}, Path=IsAdmin}"
                    Clicked="OnAddProductClicked"
                    Grid.Column="2"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
        </Grid>

        <!-- 카테고리 탭 -->
        <HorizontalStackLayout x:Name="CategoryTabBar"
                               Grid.Row="1"
                               Spacing="8"
                               Padding="10"
                               VerticalOptions="Center">
            <!-- 동적으로 Button을 추가할 예정 -->
        </HorizontalStackLayout>

        <!-- 제품 목록 -->
        <CollectionView x:Name="ProductCollection"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnProductSelected"
                        Scrolled="OnProductCollectionScrolled">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" Margin="5">
                        <StackLayout>
                            <Image Source="{Binding ., Converter={StaticResource ProductImageConverter}}" Aspect="AspectFill" HeightRequest="180" WidthRequest="180" />
                            <Label Text="{Binding codeName}" FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
