<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KSCaseProductGallery.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KSCaseProductGallery"
    Shell.FlyoutBehavior="Flyout"
    Title="KSCaseProductGallery">

    <FlyoutItem Title="제품 추가" Icon="plus.png">
        <ShellContent ContentTemplate="{DataTemplate local:AddProductPage}" />
    </FlyoutItem>

    <FlyoutItem Title="관리자 로그인" x:Name="AdminLoginMenu" Clicked="OnAdminLoginClicked" />
    <FlyoutItem Title="로그아웃" x:Name="AdminLogoutMenu" Clicked="OnAdminLogoutClicked" IsVisible="False" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
