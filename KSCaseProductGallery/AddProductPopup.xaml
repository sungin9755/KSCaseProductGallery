<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="KSCaseProductGallery.AddProductPopup">

    <Grid x:Name="RootGrid"
          Padding="20"
          BackgroundColor="White">

        <!-- Row/Column 정의는 XAML에서 기본값으로 두고, 코드에서 동적으로 변경 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 이미지 및 이미지 선택 -->
        <StackLayout x:Name="ImageStack"
                     Grid.Row="0"
                     Spacing="10"
                     HorizontalOptions="Center">
            <Frame HasShadow="False" BorderColor="#DDD" Padding="0" HeightRequest="180" WidthRequest="180">
                <Image x:Name="ProductImagePreview"
                       Source="dotnet_bot.png"
                       Aspect="AspectFill"
                       HeightRequest="180"
                       WidthRequest="180" />
            </Frame>
            <Button Text="이미지 선택" Clicked="OnPickImageClicked" />
            <Label x:Name="ImageFileNameLabel" Text="선택된 파일 없음" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
        </StackLayout>

        <!-- 입력 폼 -->
        <StackLayout x:Name="InfoStack"
                     Grid.Row="1"
                     Spacing="10">
            <Entry x:Name="ProductNameEntry" Placeholder="제품명" />
            <Entry x:Name="CodeNameEntry" Placeholder="코드명" />
            <Entry x:Name="TypeEntry" Placeholder="타입" />
            <Entry x:Name="CapacityEntry" Placeholder="용량" />
            <Entry x:Name="SizeEntry" Placeholder="사이즈" />
            <Entry x:Name="CategoryEntry" Placeholder="카테고리" />
            <Editor x:Name="DescriptionEditor" Placeholder="설명" AutoSize="TextChanges" />
            <Button Text="제품 등록" Clicked="OnAddProductClicked" />
        </StackLayout>
    </Grid>
</toolkit:Popup>