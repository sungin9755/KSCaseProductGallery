<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSCaseProductGallery.AddProductPage"
             Title="제품 추가">

    <Grid x:Name="RootGrid" Padding="40" BackgroundColor="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 이미지/파일 선택 영역 -->
        <Grid x:Name="ImageStack" Grid.Column="0" Grid.Row="0"
              HorizontalOptions="Fill" VerticalOptions="Fill">
            <Frame HasShadow="False" BorderColor="#DDD" Padding="0"
                   HorizontalOptions="Fill" VerticalOptions="Fill">
                <Image x:Name="ProductImagePreview"
                       Source="dotnet_bot.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>
            <Button Text="이미지 선택" Clicked="OnPickImageClicked"
                    VerticalOptions="End" Margin="0,10,0,0"/>
            <Label x:Name="ImageFileNameLabel" Text="선택된 파일 없음" FontSize="14" TextColor="Gray" />
        </Grid>

        <!-- 입력 폼도 StackLayout 대신 Grid로 변경 -->
        <Grid x:Name="InfoStack" Grid.Column="1" Grid.Row="0"
              HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Entry x:Name="ProductNameEntry" Placeholder="제품명" FontSize="18" Grid.Row="0"/>
            <Entry x:Name="CodeNameEntry" Placeholder="코드명" FontSize="18" Grid.Row="1"/>
            <Entry x:Name="TypeEntry" Placeholder="타입" FontSize="18" Grid.Row="2"/>
            <Entry x:Name="CapacityEntry" Placeholder="용량" FontSize="18" Grid.Row="3"/>
            <Entry x:Name="SizeEntry" Placeholder="사이즈" FontSize="18" Grid.Row="4"/>
            <Entry x:Name="CategoryEntry" Placeholder="카테고리" FontSize="18" Grid.Row="5"/>
            <Editor x:Name="DescriptionEditor" Placeholder="설명" AutoSize="TextChanges" FontSize="18" Grid.Row="6"/>
            <Button Text="제품 등록" Clicked="OnAddProductClicked" FontSize="18" HeightRequest="50" Grid.Row="7"/>
        </Grid>

        <!-- 하단 왼쪽 닫기 버튼 -->
        <Button
            x:Name="CloseButton"
            Text="닫기"
            Clicked="OnCloseClicked"
            Grid.Row="2"
            Grid.Column="0"
            HorizontalOptions="Start"
            VerticalOptions="End"
            WidthRequest="80"
            HeightRequest="44"
            Margin="0,20,0,0"/>
    </Grid>
</ContentPage>