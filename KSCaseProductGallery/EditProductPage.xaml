<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSCaseProductGallery.EditProductPage"
             Title="제품 수정">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- 상단 삭제 버튼 -->
            <HorizontalStackLayout>
                <Button Text="🗑 삭제"
                        x:Name="DeleteButton"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="Transparent"
                        TextColor="Red"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Padding="0,0,0,0"
                        />
            </HorizontalStackLayout>

            <Image x:Name="ProductImagePreview"
                   HeightRequest="180"
                   WidthRequest="180"
                   Aspect="AspectFill"
                   HorizontalOptions="Center" />
            <Button Text="이미지 변경"
                    Clicked="OnPickImageClicked"
                    HorizontalOptions="Center" />
            <Label x:Name="ImageFileNameLabel"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Entry x:Name="ProductNameEntry" Placeholder="제품명" />
            <Entry x:Name="CodeNameEntry" Placeholder="코드명" />
            <Entry x:Name="TypeEntry" Placeholder="타입" />
            <Entry x:Name="CapacityEntry" Placeholder="용량" />
            <Entry x:Name="SizeEntry" Placeholder="사이즈" />
            <Entry x:Name="CategoryEntry" Placeholder="카테고리" />
            <Editor x:Name="DescriptionEditor" Placeholder="설명" AutoSize="TextChanges" HeightRequest="80" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="저장" Clicked="OnSaveClicked" />
                <Button Text="취소" Clicked="OnCancelClicked" BackgroundColor="LightGray" TextColor="Black" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>